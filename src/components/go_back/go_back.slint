export component GoBack {
    callback clicked();

    width: 25px;
    height: 25px;

    TouchArea {
        width: 100%;
        height: 100%;
        
        clicked => { root.clicked() }

        Image {
            source: @image-url("../../../assets/icons/ep--back.svg");
            width: 25px;
            height: 25px;
            colorize: #4287f5;
        }
    }
}
